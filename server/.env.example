# Copy to .env for local development (server/.env is gitignored), or set these
# as environment variables wherever the API is deployed. Every value is
# validated at startup by src/core/config; the process refuses to boot if one
# is missing or malformed.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Required. Supabase: Project Settings -> Database -> Connection string -> URI.
# Must be the SESSION pooler (port 5432), not the transaction pooler: the
# connection-level SET statements in src/core/db/pool.ts would not outlive a
# statement in transaction mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PGPOOL_MAX=8
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Required, at least 32 characters each, and they must differ from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# Comma-separated. Must be explicit in production; a wildcard is rejected.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Optional. Without it, rate limiting and caching fall back to in-process,
# which is correct for a single instance only.
REDIS_URL=

UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=5242880

LOG_LEVEL=info
